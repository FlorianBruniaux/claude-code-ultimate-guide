{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/local-context.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "WebSearch"
    ],
    "ask": [
      "Bash(npm run build)",
      "Bash(docker build *)",
      "Bash(cargo build --release)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(dd *)",
      "Bash(mkfs.*)"
    ]
  }
}
