{
  "name": "claude-code-ultimate-guide-mcp",
  "version": "1.3.0",
  "description": "Search, read, and explore the Claude Code Ultimate Guide from any MCP-compatible coding client",
  "keywords": [
    "mcp",
    "claude-code",
    "anthropic",
    "documentation",
    "guide"
  ],
  "author": "Florian Bruniaux",
  "license": "MIT",
  "homepage": "https://github.com/FlorianBruniaux/claude-code-ultimate-guide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlorianBruniaux/claude-code-ultimate-guide.git",
    "directory": "mcp-server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "claude-code-ultimate-guide-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "content"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/index.js",
    "dev": "GUIDE_ROOT=.. node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "manifest": "npm run build && node scripts/generate-product-manifest.mjs",
    "manifest:check": "npm run build && node scripts/generate-product-manifest.mjs --check",
    "docs:product": "node scripts/render-product-docs.mjs",
    "docs:product:check": "node scripts/render-product-docs.mjs --check",
    "release:check": "npm ci && npm test && npm run manifest:check && npm run docs:product:check && npm pack --dry-run --json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "yaml": "^2.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
