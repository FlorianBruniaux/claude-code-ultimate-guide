{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlorianBruniaux/claude-code-ultimate-guide/blob/main/machine-readable/ai-design-patterns.schema.json",
  "title": "AI design patterns crosswalk",
  "type": "object",
  "required": ["version", "last_verified", "guide_page", "site_path", "families", "crosswalk", "native", "anti_patterns", "anti_pattern_categories", "sources"],
  "additionalProperties": true,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "mechanism": {
      "type": "object",
      "required": ["name", "doc"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "doc": { "type": "string", "pattern": "^https://code\\.claude\\.com/docs/" }
      }
    },
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "infographic": {
      "type": "object",
      "required": ["file", "alt"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "^guide/images/ai-design-patterns/patterns/[a-z0-9-]+\\.webp$" },
        "alt": { "type": "string", "minLength": 40 }
      }
    },
    "videoRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "t", "point"],
        "additionalProperties": false,
        "properties": { "source": { "$ref": "#/$defs/id" }, "t": { "type": "integer", "minimum": 0 }, "point": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "properties": {
    "version": { "type": "string" },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "guide_page": { "type": "string" },
    "site_path": { "type": "string" },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" } }
      }
    },
    "crosswalk": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "classic", "family", "classic_intent", "agent_analogue", "claude_code", "consensus", "provenance", "failure_mode", "verify", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "classic": { "type": "string" },
          "family": { "$ref": "#/$defs/id" },
          "classic_intent": { "type": "string" },
          "agent_analogue": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "sources"],
              "additionalProperties": false,
              "properties": { "label": { "type": "string" }, "sources": { "$ref": "#/$defs/sourceRefs" } }
            }
          },
          "claude_code": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mechanism" } },
          "consensus": { "enum": ["consensus", "single-source", "divergent"] },
          "provenance": { "enum": ["third-party", "own-synthesis"] },
          "failure_mode": { "type": "string" },
          "verify": { "type": "string" },
          "sources": { "$ref": "#/$defs/sourceRefs" },
          "infographic": { "$ref": "#/$defs/infographic" },
          "videos": { "$ref": "#/$defs/videoRefs" }
        }
      }
    },
    "native": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "summary", "why_new", "claude_code", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "why_new": { "type": "string" },
          "claude_code": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mechanism" } },
          "sources": { "$ref": "#/$defs/sourceRefs" },
          "infographic": { "$ref": "#/$defs/infographic" },
          "videos": { "$ref": "#/$defs/videoRefs" }
        }
      }
    },
    "anti_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "symptom", "fix", "category", "patterns", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "symptom": { "type": "string" },
          "fix": { "type": "string" },
          "category": { "$ref": "#/$defs/id" },
          "patterns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
          "sources": { "$ref": "#/$defs/sourceRefs" }
        }
      }
    },
    "anti_pattern_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "source"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "source": { "type": ["string", "null"] } }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "author", "url", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string" },
          "author": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "kind": { "enum": ["crosswalk", "catalog", "paper", "vendor", "article", "classic", "official", "video"] }
        }
      }
    }
  }
}
