{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cc.bruniaux.com/schemas/navigation.schema.json",
  "title": "Claude Code Ultimate Guide intent navigation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "last_updated",
    "site_base_url",
    "purpose",
    "groups"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "site_base_url": {
      "type": "string",
      "format": "uri"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "items"],
      "properties": {
        "id": {
          "enum": ["start", "build", "scale", "resources", "updates"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "site_path",
        "source_path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "site_path": {
          "type": "string",
          "pattern": "^/"
        },
        "source_path": {
          "type": ["string", "null"]
        },
        "source_anchor": {
          "type": "string",
          "pattern": "^#"
        }
      }
    }
  }
}
