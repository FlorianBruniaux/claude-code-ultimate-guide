{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cc.bruniaux.com/machine-readable/agent-harnesses.schema.json",
  "title": "Agent Harness Landscape",
  "description": "Canonical evidence-aware dataset for the broad upstream catalog, guide supplements, strict runtimes, and adjacent control planes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_meta", "stats", "sets"],
  "properties": {
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "generated_at", "license", "provenance", "dataset_sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "generated_at": {"type": "string", "format": "date-time"},
        "license": {"type": "string", "minLength": 1},
        "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["upstream_repository", "upstream_commit", "upstream_snapshot_date", "methodology"],
          "properties": {
            "upstream_repository": {"type": "string", "format": "uri", "pattern": "^https://"},
            "upstream_commit": {"const": "ece314654d2c23fe7bd69fc6ef7088f093207e49"},
            "upstream_snapshot_date": {"type": "string", "format": "date"},
            "methodology": {"type": "string", "format": "uri", "pattern": "^https://"}
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream_project_count",
        "upstream_category_count",
        "guide_supplement_count",
        "strict_runtime_count",
        "adjacent_control_plane_count",
        "open_source_count",
        "deep_dive_count",
        "headless_count",
        "durable_count",
        "autonomy_not_applicable_count",
        "recovery_not_applicable_count"
      ],
      "properties": {
        "upstream_project_count": {"const": 160},
        "upstream_category_count": {"const": 12},
        "guide_supplement_count": {"type": "integer", "minimum": 0},
        "strict_runtime_count": {"const": 42},
        "adjacent_control_plane_count": {"const": 15},
        "open_source_count": {"const": 118},
        "deep_dive_count": {"const": 86},
        "headless_count": {"const": 46},
        "durable_count": {"const": 8},
        "autonomy_not_applicable_count": {"const": 65},
        "recovery_not_applicable_count": {"const": 64}
      }
    },
    "sets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_snapshot", "guide_supplement", "strict_runtime_map", "adjacent_control_planes"],
      "properties": {
        "upstream_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "snapshot_date", "license", "categories", "projects"],
          "properties": {
            "repository": {"const": "https://github.com/RyanAlberts/best-of-Agent-Harnesses"},
            "commit": {"const": "ece314654d2c23fe7bd69fc6ef7088f093207e49"},
            "snapshot_date": {"const": "2026-08-23"},
            "license": {"const": "CC-BY-SA-4.0"},
            "categories": {
              "type": "array",
              "minItems": 12,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/category"}
            },
            "projects": {
              "type": "array",
              "minItems": 160,
              "maxItems": 160,
              "items": {"$ref": "#/$defs/project"}
            }
          }
        },
        "guide_supplement": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/project"}
        },
        "strict_runtime_map": {
          "type": "array",
          "minItems": 42,
          "maxItems": 42,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/mapEntry"},
              {
                "properties": {
                  "owns_loop": {"enum": ["confirmed", "claimed"]}
                },
                "allOf": [
                  {
                    "if": {
                      "required": ["owns_loop"],
                      "properties": {"owns_loop": {"const": "confirmed"}}
                    },
                    "then": {
                      "properties": {
                        "evidence_status": {"const": "confirmed"}
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "adjacent_control_planes": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {
            "allOf": [
              {"$ref": "#/$defs/mapEntry"},
              {
                "properties": {
                  "owns_loop": {"const": "no"}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "status", "url", "checked_at"],
      "properties": {
        "source_type": {"type": "string", "minLength": 1},
        "status": {"enum": ["confirmed", "claimed", "unknown", "not_applicable"]},
        "url": {
          "allOf": [
            {"$ref": "#/$defs/httpsUrl"},
            {
              "if": {"pattern": "^https://(?:www\\.)?github\\.com/"},
              "then": {
                "pattern": "^https://github\\.com/[^/]+/[^/]+/(?:blob|commit)/[0-9a-fA-F]{40}(?:/|$)"
              }
            },
            {
              "if": {"pattern": "^https://raw\\.githubusercontent\\.com/"},
              "then": {
                "pattern": "^https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/[0-9a-fA-F]{40}/"
              }
            }
          ]
        },
        "checked_at": {"type": "string", "format": "date"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "evidence"],
      "properties": {
        "value": {},
        "status": {"enum": ["confirmed", "claimed", "unknown", "not_applicable"]},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "checked_at"],
      "properties": {
        "source_commit": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          ]
        },
        "checked_at": {"type": "string", "format": "date"}
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "count"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "project_url", "repository_url", "homepage_url", "category",
        "summary", "owns_loop", "stars", "stars_captured_at", "license_signal",
        "archived", "language", "interfaces", "provider_strategy", "tags",
        "adoption_surface", "autonomy", "recovery", "features", "freshness", "provenance"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "project_url": {"$ref": "#/$defs/httpsUrl"},
        "repository_url": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/httpsUrl"}]},
        "homepage_url": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/httpsUrl"}]},
        "category": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "owns_loop": {"enum": ["confirmed", "claimed", "unknown", "no"]},
        "stars": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "stars_captured_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date"}]},
        "license_signal": {"type": "string", "minLength": 1},
        "archived": {"oneOf": [{"type": "boolean"}, {"const": "unknown"}]},
        "language": {"type": "string", "minLength": 1},
        "interfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "provider_strategy": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "adoption_surface": {"enum": ["super_simple", "mostly_simple", "slightly_complex", "complex", "unknown"]},
        "autonomy": {"enum": ["step_gated", "checkpoint_gated", "bounded", "headless", "unknown", "not_applicable"]},
        "recovery": {"enum": ["none", "retry", "resumable", "durable", "unknown", "not_applicable"]},
        "features": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/feature"}
        },
        "freshness": {"$ref": "#/$defs/freshness"},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["stars"],
            "properties": {"stars": {"type": "integer"}}
          },
          "then": {
            "properties": {
              "repository_url": {"$ref": "#/$defs/httpsUrl"},
              "stars_captured_at": {"type": "string", "format": "date"}
            }
          }
        },
        {
          "if": {
            "required": ["repository_url"],
            "properties": {"repository_url": {"type": "null"}}
          },
          "then": {
            "properties": {
              "stars": {"type": "null"},
              "stars_captured_at": {"type": "null"}
            }
          }
        }
      ]
    },
    "mapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "project_ref", "source_set", "owns_loop", "evidence_status", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "project_ref": {"type": "string", "minLength": 1},
        "source_set": {"enum": ["upstream_snapshot", "guide_supplement"]},
        "owns_loop": {"enum": ["confirmed", "claimed", "unknown", "no"]},
        "evidence_status": {"enum": ["confirmed", "claimed"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["evidence_status"],
            "properties": {"evidence_status": {"const": "confirmed"}}
          },
          "then": {
            "properties": {
              "evidence": {
                "items": {"properties": {"status": {"const": "confirmed"}}}
              }
            }
          }
        },
        {
          "if": {
            "required": ["evidence_status"],
            "properties": {"evidence_status": {"const": "claimed"}}
          },
          "then": {
            "properties": {
              "evidence": {
                "items": {"properties": {"status": {"const": "claimed"}}}
              }
            }
          }
        }
      ]
    }
  }
}
